---

generic:
  role_description: |
    Role to open firewall ports for incoming traffic.
    Supports firewalld, ufw, iptables and Windows firewall

# Supported platforms
platforms:
  ubuntu2004:
    supported: true
    ci: true
  win2012r2:
    supported: true
    ci: false
  win2016:
    supported: true
    ci: false
  win2019:
    supported: true
    ci: false
  win2022:
    supported: true
    ci: false

# Supported platforms - overwrite
platforms_overwrite:
  debian12:
    molecule:
      podman:
        privileged: false
        capabilities:
          - NET_ADMIN
          - NET_RAW
  debian13:
    molecule:
      podman:
        privileged: false
        capabilities:
          - NET_ADMIN
          - NET_RAW
  ubuntu2004:
    molecule:
      podman:
        privileged: false
        capabilities:
          - NET_ADMIN
          - NET_RAW
  ubuntu2204:
    molecule:
      podman:
        privileged: false
        capabilities:
          - NET_ADMIN
          - NET_RAW
  ubuntu2404:
    molecule:
      podman:
        privileged: false
        capabilities:
          - NET_ADMIN
          - NET_RAW
  ubuntu2604:
    molecule:
      podman:
        privileged: false
        capabilities:
          - NET_ADMIN
          - NET_RAW

# Molecule
molecule:
  driver: podman
  prepare:
    vars:
      prepare_firewall: true
  converge:
    vars:
      firewall_ports:
        - name: SSH
          port: "22"
          proto: tcp
        - name: DNS
          port: "53"
          proto: udp

# Roles & collections dependencies
dependencies:
  roles:
    - deitkrachten.firewalld
    - deitkrachten.iptables
    - deitkrachten.ufw
